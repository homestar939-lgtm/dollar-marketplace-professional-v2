# PostgreSQL for the local company network
DATABASE_URL="postgresql://dollar:CHANGE_ME@127.0.0.1:5432/dollar?schema=public"

# Generate with: openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"
BCRYPT_ROUNDS="12"

PORT="4000"
NODE_ENV="production"
# Exact browser origins served on the LAN, comma-separated (no trailing slash).
# Example: http://192.168.1.50:5173,http://192.168.1.60:8080
CORS_ORIGINS="http://192.168.1.50:5173"

# Set unique, random values in a secret manager before the first seed.
# Production requires at least 24 characters for each; they are not logged.
SEED_ADMIN_PASSWORD=""
SEED_WAREHOUSE_PASSWORD=""
SEED_COLLECTOR_PASSWORD=""
SEED_ACCOUNTANT_PASSWORD=""
SEED_BUYER_PASSWORD=""
