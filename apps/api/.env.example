# --- Database (PostgreSQL 14+) ------------------------------------------------
DATABASE_URL="postgresql://dollar:dollar@localhost:5432/dollar?schema=public"

# --- Auth ---------------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-16-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"
BCRYPT_ROUNDS="10"

# --- Email verification / password reset --------------------------------------
EMAIL_VERIFICATION_TTL_MINUTES="1440"
PASSWORD_RESET_TTL_MINUTES="60"
# Dev only: return verification/reset tokens in the API response instead of
# sending email. MUST stay "false" in production.
EXPOSE_TOKENS="false"

# --- Google Sign-In (Android + Web) ------------------------------------------
# The OAuth client id the Android app requests its ID token with. The API
# verifies every token against Google and checks this audience.
GOOGLE_CLIENT_ID=""

# --- Server -------------------------------------------------------------------
PORT="4000"
NODE_ENV="development"
CORS_ORIGINS="*"

# --- Demo mode (النسخة التجريبية) ---------------------------------------------
# بيئة development فقط: "true" تعرض الدخول التجريبي، و"false" تعرض تسجيل الدخول الحقيقي.
# في production تُرفض الإعدادات التجريبية أو CORS="*" أو الرموز الضعيفة عند إقلاع API.
DEMO_MODE="true"

# --- First production administrator (one-time seed only) -----------------------
# لا تضع بيانات حقيقية في هذا الملف أو في Git. مرّرها من مخزن أسرار النشر.
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
